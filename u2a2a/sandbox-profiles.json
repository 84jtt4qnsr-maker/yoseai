        "denyRead": ["<dataDir>", "<profilesPath>", "<home>/.codex", "<home>/.grok"],
        "denyWrite": ["<poolDir>", "<repoRoot>"]
      },
      "net": { "allowDomains": ["*.anthropic.com", "api.anthropic.com", "statsig.anthropic.com", "sentry.io", "*.sentry.io"], "loopback": [] },
      "unverified": ["cliCredentials", "cliSessionStore", "controlSocket", "mcp", "execFiles"]
